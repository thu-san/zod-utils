# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# npm (NEVER commit .npmrc with tokens or credentials)
# The .npmrc in the root is safe to commit as it contains no secrets
# Local user .npmrc with credentials should remain in ~/.npmrc
.npmrc.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts
