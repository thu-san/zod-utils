# NPM Security Configuration
# This file configures npm behavior for security and reliability

# Security: Always use exact versions for production dependencies
# This prevents unexpected updates that could introduce vulnerabilities
save-exact=false
# Note: Set to false to preserve semver ranges from package.json
# Individual packages can use exact versions when needed

# Security: Enable audit checks during installation
audit=true
audit-level=moderate

# Security: Disable automatic script execution from dependencies
# This prevents malicious packages from running arbitrary code during install
ignore-scripts=false
# Note: Set to false for now as some dependencies require scripts (husky, etc.)
# Consider enabling and whitelisting specific packages if needed

# Security: Ensure package-lock.json is always used
package-lock=true

# Security: Require package checksums to match
package-lock-only=false

# Performance: Prefer offline mode for faster installs (when possible)
# Note: CI/CD should use 'npm ci' which respects this
prefer-offline=false

# Registry Configuration
registry=https://registry.npmjs.org/

# Security: Only allow HTTPS for registry communication
strict-ssl=true

# Logging: Set appropriate log level
loglevel=warn

# Publishing: Generate provenance attestations (requires Node.js 16+)
# This creates a signed record of where and how the package was built
provenance=true

# Publishing: Access level for @zod-utils scope
access=public

# Fund: Disable funding messages in CI (keeps logs clean)
fund=false

# Update: Show outdated packages during install
update-notifier=true

# Engine: Enforce Node.js version from package.json
engine-strict=true

# Legacy: Disable legacy peer dependency resolution
legacy-peer-deps=false

# Progress: Disable progress bar in CI environments
# This will be overridden by CI=true environment variable
progress=true

# Save: Default save behavior for npm install
save=true

# Fetch: Network retry configuration
fetch-retries=3
fetch-retry-factor=10
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Security: Optional - uncomment to enable signature verification
# Before enabling, ensure you have configured signing keys
# require-signature=true

# Development: Optional - uncomment to prefer offline mode
# This can speed up local development but may cause issues with fresh installs
# prefer-offline=false

# Security Note: For CI/CD environments, consider using:
# - NPM_TOKEN as environment variable instead of .npmrc
# - Different .npmrc for local development vs CI
# - npm ci instead of npm install for reproducible builds
